		 * "  <Skey ci=\"20280825\"></Skey>\n"
		 * +
		 * "  <Hmac>LKLp9m7cOdtX78FAS0aBUZROB2y32z2L5hJ6SMdAj0/3aIFNLg1EEMVUlM+LM/Uo</Hmac>\n"
		 * +
		 * "  <Data type=\"X\"></Data>\n"
		 * + "</PidData>";
		 */

		String base64String = util.convertPidXmlToBase64Json(input.getBioMetricData());
		log.info("base64String :: {}", base64String);

		try {

			Optional<AgentMasterEntity> agentEntity = agentRepo.findByVkidAndJioAgentIdIsNotNull(input.getVkid());
			if (agentEntity.isPresent()) {
				AgentMasterEntity agent = agentEntity.get();
				agentId = agent.getJioAgentId();
				log.info("Agent Master Details for the VKID :: {}, {}", input.getVkid(), agent.toString());
			}

			// Token
			if (!tokenManager.isAccessTokenValid()) {
				log.info("Token expired → generating new token");
				auth.generateToken(httpRequest);
			}

			// Request
			CustomerPanAadharVerifyRequestDTO request = new CustomerPanAadharVerifyRequestDTO();

			request.setApplicationNumber(input.getApplicationNumber());
			request.setExternalAppRefNumber(input.getExternalAppRefNumber());
			request.setApiVersion(apiVersion);
			request.setApplicationType(applicationType);
			request.setApplicationSubType(applicationSubType);
			request.setInitiatingEntityId(channelId);

			// Action
			ActionDTO action = new ActionDTO();
			action.setType("AADHAAR");
			action.setSubType("EKYC-BIOMETRIC");
			request.setAction(action);

			// Organization
			OrganizationDTO org = new OrganizationDTO();
			org.setId(oranizationName);
			request.setOrganization(org);

			// Financial Details + Persons
			FinancialDetailsDTO finance = new FinancialDetailsDTO();
			PersonDTO person = new PersonDTO();
			finance.setPanNumber(input.getPanNo());
			person.setFinancialDetails(finance);
			request.setPersons(Collections.singletonList(person));

			// Authenticate + Aadhar Details
			AuthenticateEkycDTO authenticate = new AuthenticateEkycDTO();
			AadhaarDTO aadhar = new AadhaarDTO();
			aadhar.setType("UID");
			aadhar.setValue(input.getAadharNo());
			authenticate.setAadhaar(aadhar);
			authenticate.setValue(base64String);// check
			request.setAuthenticateList(Collections.singletonList(authenticate));

			// BCDetails
			BCDetailsDTO bc = new BCDetailsDTO();
			bc.setUserId(agentId);
			request.setBcDetails(bc);

			// consents from the frontend Itself
			request.setConsents(input.getConsents());

//			// Consents
//			List<ConsentDTO> finalConsents = new ArrayList<>();
//
//			// Aadhar Consent
//			ConsentDTO consents = new ConsentDTO();
//			consents.setCode("B88");
//			consents.setVersion("1");
//			consents.setMethod("checkbox");
//			consents.setConsent(
//					"I hereby provide my consent to Jio Payments Bank Limited (Bank) to use my Aadhaar number and "
//							+ "biometric authentication to verify my identity for the purpose of doing AePS transactions from my account "
//							+ "(Service) . I have reviewed the transaction details and found to be correct. I understand and agree to the "
//							+ "terms and conditions governing the Service as available on website www.jiopaymentsbank.com and confirm that my "
//							+ "biometric authentication be treated as my consent for availing the Service from the Bank. I hereby give my "
//							+ "consent to receive promotional content on behalf of the Bank.");
//			finalConsents.add(consents);
//
//			// DBT Consents Should be optional
//			ConsentDTO dbtConsents = new ConsentDTO();
//			dbtConsents.setCode("C50");
//			dbtConsents.setVersion("1");
//			dbtConsents.setMethod("checkbox");
//			dbtConsents.setConsent("DBT Consents");
//			finalConsents.add(dbtConsents);
//
//			request.setConsents(finalConsents);
//			// Consents from the input)
//			request.setConsents(input.getConsents());

			log.info("Customer Pan Aadhar Verify request :: {}", request.toString());
			log.info("JSON Request for Customer Pan Aadhar Verify :: {}", mapper.writeValueAsString(request));

			HttpHeaders headers = util.buildHeaders(httpRequest, tokenManager.getAccessToken(),
					tokenManager.getAppIdentifierToken(), input.getLatitude(), input.getLongitude());

			HttpEntity<CustomerPanAadharVerifyRequestDTO> entity = new HttpEntity<>(request, headers);

			ResponseEntity<String> response = null;
			String responseBody = null;
			Integer statusCode = null;

			try {
//				responseBody = """
//						{
//						  "externalAppRefNumber": "REF1777982904338",
//						  "applicationNumber": "JPBREF177798290433872922",
//						  "status": "SUCCESS",
//						  "nextAction": {
//						    "type": "APPLICATION",
//						    "subType": "SUBMIT"
//						  },
//						  "data": {
//						    "persons": {
//						      "aadhaar": {
//						        "type": "token",
//						        "value": "01001255ESUXhKglTPUkG5QvpEIa4Zdt18n9/ZZoFEyi48xIxOT62WbbL9HtKdju+igGd7KU",
//						        "maskedAadhaar": "XXXXXXXX4372",
//						        "name": "Sai Vinayak Shekhar Bangera",
//						        "dob": "01-09-1987",
//						        "address": {
//						          "line1": null,
//						          "line2": null,
//						          "line3": null,
//						          "addressType": "PERMANENT",
//						          "careOf": null,
//						          "houseNumber": "B-301, Hari Mandir CHS,",
//						          "street": null,
//						          "landmark": "Near Arunodaya Hospital,",
//						          "locality": "Sector-10, New Panvel, Navi Mumbai",
//						          "city": null,
//						          "postOffice": "Panvel",
//						          "district": "Raigad",
//						          "subDistrict": null,
//						          "state": "Maharashtra",
//						          "stateCode": null,
//						          "country": "India",
//						          "pincode": "410206",
//						          "geoLocation": null,
//						          "sameAsPermanent": false
//						        },
//						        "photo": "",
//						        "gender": "M",
//						        "timestamp": null,
//						        "authCode": null,
//						        "authMode": null,
//						        "saTxnId": null,
//						        "aadhaarXml": null,
//						        "isResidentForeigner": null,
//						        "demoAuthStatus": null
//						      },
//						      "financialDetails": {
//						        "panNumber": "LYPPS1933L",
//						        "nameAsPerPan": null,
//						        "dobAsPerPan": null,
//						        "panStatus": "E",
//						        "aadhaarSeedStatus": "Y",
//						        "nameStatus": "N",
//						        "dobStatus": "N",
//						        "nameMatchPer": null,
//						        "sourceOfIncome": null,
//						        "occupation": null,
//						        "subOccupation": null,
//						        "incomeRange": null,
//						        "annualSalary": null
//						      }
//						    }
//						  }
//						}
//						""";
//
//						statusCode = 200;
//				log.info("Customer Pan Aadhar Verify Mock Response :: {}", responseBody);

				response = rest.exchange(URL, HttpMethod.POST, entity, String.class);
				log.info("Customer Pan Aadhar Verify Raw Response :: {}", response.getBody());
				responseBody = response.getBody();
				statusCode = response.getStatusCode().value();

			} catch (HttpStatusCodeException ex) {
				statusCode = ex.getStatusCode().value();
				responseBody = ex.getResponseBodyAsString();
				log.error("API error: {}, body: {}", statusCode, responseBody);

			} catch (ResourceAccessException ex) {
				statusCode = 408;
				responseBody = "Timeout: " + ex.getMessage();
				log.error("API timeout", ex);

			} catch (Exception ex) {
				statusCode = 500;
				responseBody = "Unexpected error: " + ex.getMessage();
				log.error("API failure", ex);
			}

			if (statusCode != null && statusCode == 200 && responseBody != null) {
				try {
					finalResponse = mapper.readValue(responseBody, CustomerPanAadharVerifyResponseDTO.class);
					Map<String, String> addressLines = util.buildAddressLines(finalResponse);
					
					  if (finalResponse.getData() != null
				                && finalResponse.getData().getPersons() != null
				                && finalResponse.getData().getPersons().getAadhaar() != null
				                && finalResponse.getData().getPersons().getAadhaar().getAddress() != null) {

				            AddressDTO address = finalResponse.getData()
				                    .getPersons()
				                    .getAadhaar()
				                    .getAddress();

				            address.setLine1(addressLines.get("line1"));
				            address.setLine2(addressLines.get("line2"));
				            address.setLine3(addressLines.get("line3"));

				            log.info("Final Address Line1 :: {}", address.getLine1());
				            log.info("Final Address Line2 :: {}", address.getLine2());
				            log.info("Final Address Line3 :: {}", address.getLine3());
				        }
					
				} catch (Exception e) {
					error.setCode("500");
					error.setMessage("Response parsing failed");
					finalResponse.setError(error);
					finalResponse.setStatus("FAILED");
				}
			} else {

				error.setCode(String.valueOf(statusCode));
				error.setMessage(responseBody != null ? responseBody : "API Failed");
				finalResponse.setStatus("FAILED");
				finalResponse.setError(error);
			}

			String errorMsg = (finalResponse.getError() == null || finalResponse.getError().getMessage() == null)
					? "No Error Msg"
					: finalResponse.getError().getMessage();

			// DB Activity --------------------------------------------------------------
			Optional<CustomerMasterEntity> masterEntity = masterRepo.findByApplicationNumberAndExternalAppRefNumber(
					input.getApplicationNumber(), input.getExternalAppRefNumber());

			if (masterEntity.isEmpty()) {
				throw new RuntimeException("Customer not found with same Application-No & ExternalRefNo");
			}

			if (masterEntity.isPresent()) {
				master = masterEntity.get();
				masterId = master.getId();
				log.info("VKID :: {}, row :: {}", input.getVkid(), masterId);

				master.setActionType("AADHAAR");
				master.setActionSubType("EKYC-BIOMETRIC");
				master.setEmail(input.getEmailId());
				master.setStatus(finalResponse.getStatus());
				master.setPanNo(input.getPanNo());
				master.setAadharNo(input.getAadharNo());
			}

			// SAVE API LOG
			CustomerApiLogEntity logEntity = new CustomerApiLogEntity();
			logEntity.setMasterId(masterId);
			logEntity.setApiName("PAN-AADHAAR-VERIFY");
			logEntity.setRequestPayload(mapper.writeValueAsString(request));
			logEntity.setResponsePayload(response.getBody());
			logEntity.setStatusCode(response.getStatusCode().value());
//			logEntity.setResponsePayload(responseBody);
//			logEntity.setStatusCode(statusCode);
			logEntity.setCreatedAt(LocalDateTime.now());
			logEntity.setTraceId(finalResponse.getExternalAppRefNumber());
			logEntity.setErrorMessage(errorMsg);

			// SAVE HISTORY
			CustomerHistoryEntity history = new CustomerHistoryEntity();
			history.setMasterId(masterId);
			history.setExternalAppRefNo(finalResponse.getExternalAppRefNumber());
			history.setApplicationNum(finalResponse.getApplicationNumber());
			history.setApplicationType(applicationType);
			history.setApplicationSubType(applicationSubType);
			history.setApiName("PAN-AADHAAR-VERIFY");
			history.setStatus(finalResponse.getStatus());
			history.setActionType("AADHAAR");
			history.setActionSubType("EKYC-BIOMETRIC");
			history.setGeneratedDateTime(LocalDateTime.now());
			history.setJioAgentId(agentId);

			// Common Method for Success + Failure [History + API log + Master]
			if ("SUCCESS".equalsIgnoreCase(finalResponse.getStatus())) {
				// Master
				master.setNextActionType(finalResponse.getNextAction().getType());
				master.setNextActionSubType(finalResponse.getNextAction().getSubType());
				master.setStage(6);

				// History
				history.setNextActionType(finalResponse.getNextAction().getType());
				history.setNextActionSubType(finalResponse.getNextAction().getSubType());
				history.setRemarks("PAN Aadhaar Verfied");
			} else {
				history.setRemarks("PAN Aadhaar Verfication Pending");
			}

			masterRepo.save(master);
			apiLogRepo.save(logEntity);
			historyRepo.save(history);
			// --------------------------------------------------------------

			return ResponseEntity.ok(finalResponse);

		} catch (Exception e) {
			log.error("Customer Pan Aadhar Verify Exception", e);
			error.setCode("500");
			error.setMessage(e.getMessage());
			finalResponse.setStatus("FAILED");
			finalResponse.setError(error);

			return ResponseEntity.ok(finalResponse);
		}
	}

	// Preview Customer Data
	@Override
	public ResponseEntity<?> preview(CustomerInputRequestDTO input, HttpServletRequest httpRequest) {

		log.info("Preview Application Request from Customer :: {}", input.toString());
		ObjectMapper mapper = new ObjectMapper();

		CustomerCommonRequestDTO finalRequest = new CustomerCommonRequestDTO();
		PreviewApplicationResponseDTO finalResponse = new PreviewApplicationResponseDTO();
		ErrorDetails error = new ErrorDetails();
		try {

			// Token
			if (!tokenManager.isAccessTokenValid()) {
				log.info("Token expired → generating new token");
				auth.generateToken(httpRequest);
			}

			log.info("Preview Application request :: {}", input.toString());

			finalRequest.setApplicationNumber(input.getApplicationNumber());
			finalRequest.setInitiatingEntityId(channelId);

			log.info("JSON Request for Preview Application :: {}", mapper.writeValueAsString(finalRequest));

			HttpHeaders headers = util.buildHeaders(httpRequest, tokenManager.getAccessToken(),
					tokenManager.getAppIdentifierToken(), input.getLatitude(), input.getLongitude());

			HttpEntity<CustomerCommonRequestDTO> entity = new HttpEntity<>(finalRequest, headers);

			ResponseEntity<String> response = null;
			String responseBody = null;
			Integer statusCode = null;
			try {
				response = rest.exchange(previewURL, HttpMethod.POST, entity, String.class);
				log.info("Preview Application Raw Response :: {}", response.getBody());
				responseBody = response.getBody();
				statusCode = response.getStatusCode().value();

			} catch (HttpStatusCodeException ex) {
				statusCode = ex.getStatusCode().value();
				responseBody = ex.getResponseBodyAsString();
				log.error("API error: {}, body: {}", statusCode, responseBody);

			} catch (ResourceAccessException ex) {
				statusCode = 408;
				responseBody = "Timeout: " + ex.getMessage();
				log.error("API timeout", ex);

			} catch (Exception ex) {
				statusCode = 500;
				responseBody = "Unexpected error: " + ex.getMessage();
				log.error("API failure", ex);
			}

			if (statusCode != null && statusCode == 200 && responseBody != null) {
				try {
					finalResponse = mapper.readValue(responseBody, PreviewApplicationResponseDTO.class);
				} catch (Exception e) {
					error.setCode("500");
					error.setMessage("Response parsing failed");
					finalResponse.setError(error);
					finalResponse.setStatus("FAILED");
				}
			} else {

				error.setCode(String.valueOf(statusCode));
				error.setMessage(responseBody != null ? responseBody : "API Failed");
				finalResponse.setStatus("FAILED");
				finalResponse.setError(error);
			}

			String errorMsg = (finalResponse.getError() == null || finalResponse.getError().getMessage() == null)
					? "No Error Msg"
					: finalResponse.getError().getMessage();

			return ResponseEntity.ok(finalResponse);

		} catch (Exception e) {
			log.error("Preview Application Exception", e);
			throw new RuntimeException("Preview Application failed", e);
		}
	}

	// Customer E-Auth
	@Override
	@Transactional
	public ResponseEntity<?> customerAuth(CustomerInputRequestDTO input, HttpServletRequest httpRequest) {
		log.info("Customer E-Auth Request from Customer :: {}", input.toString());
		ObjectMapper mapper = new ObjectMapper();
		ErrorDetails error = new ErrorDetails();
		String agentId = null;
		Integer masterId = null;
		CustomerMasterEntity master = null;
		CustomerEAuthResponseDTO finalResponse = new CustomerEAuthResponseDTO();
		String aadharNo = null;
		log.info("JSON Customer E-Auth Request from Customer :: {}", mapper.writeValueAsString(input));
		try {

			Optional<AgentMasterEntity> agentEntity = agentRepo.findByVkidAndJioAgentIdIsNotNull(input.getVkid());
			if (agentEntity.isPresent()) {
				AgentMasterEntity agent = agentEntity.get();
				agentId = agent.getJioAgentId();
				log.info("Agent Master Details for the VKID :: {}, {}", input.getVkid(), agent.toString());
			}
			
			Optional<CustomerMasterEntity> masterEntity = masterRepo.findByApplicationNumberAndExternalAppRefNumber(
					input.getApplicationNumber(), input.getExternalAppRefNumber());
			if(masterEntity.isPresent()) {
				master = masterEntity.get();
				aadharNo = master.getAadharNo();
				log.info("Aadhar No for the user :: {}", aadharNo);
			}			

			// Token
			if (!tokenManager.isAccessTokenValid()) {
				log.info("Token expired → generating new token");
				auth.generateToken(httpRequest);
			}

			String base64String = util.convertPidXmlToBase64Json(input.getBioMetricData());
			log.info("base64String :: {}", base64String);

			// Request
			CustomerEAuthRequestDTO request = new CustomerEAuthRequestDTO();
			request.setApplicationNumber(input.getApplicationNumber());
			request.setExternalAppRefNumber(input.getExternalAppRefNumber());
			request.setApiVersion(apiVersion);
			request.setApplicationType("CustomerOnboarding");
			request.setApplicationSubType("SAVINGS");
			request.setInitiatingEntityId(channelId);

			// Action
			ActionDTO action = new ActionDTO();
			action.setType("AADHAAR");
			action.setSubType("EAUTH-BIOMETRIC");
			request.setAction(action);

			// Organization
			OrganizationDTO org = new OrganizationDTO();
			org.setId(oranizationName);
			request.setOrganization(org);

			AuthenticateEkycDTO authenticate = new AuthenticateEkycDTO();
			AadhaarDTO aadhar = new AadhaarDTO();
			aadhar.setType("UID");
//			aadhar.setValue(input.getAadharNo());
			aadhar.setValue(aadharNo);//------ fetching from DB
			authenticate.setAadhaar(aadhar);
			authenticate.setValue(base64String);// check
			request.setAuthenticateList(Collections.singletonList(authenticate));

			// BCDetails
			BCDetailsDTO bc = new BCDetailsDTO();
			bc.setUserId(agentId);
			request.setBcDetails(bc);

			// Consents
			Optional.ofNullable(input.getConsents()).ifPresent(con -> {
				request.setConsents(con);
			});

			log.info("JSON Request for Customer E-Auth :: {}", mapper.writeValueAsString(request));

			HttpHeaders headers = util.buildHeaders(httpRequest, tokenManager.getAccessToken(),
					tokenManager.getAppIdentifierToken(), input.getLatitude(), input.getLongitude());

			HttpEntity<CustomerEAuthRequestDTO> entity = new HttpEntity<>(request, headers);

			ResponseEntity<String> response = null;
			String responseBody = null;
			Integer statusCode = null;

			try {

				response = rest.exchange(URL, HttpMethod.POST, entity, String.class);
				log.info("Customer E-Auth Raw Response :: {}", response.getBody());
				responseBody = response.getBody();
				statusCode = response.getStatusCode().value();

			} catch (HttpStatusCodeException ex) {
				statusCode = ex.getStatusCode().value();
				responseBody = ex.getResponseBodyAsString();
				log.error("API error: {}, body: {}", statusCode, responseBody);

			} catch (ResourceAccessException ex) {
				statusCode = 408;
				responseBody = "Timeout: " + ex.getMessage();
				log.error("API timeout", ex);

			} catch (Exception ex) {
				statusCode = 500;
				responseBody = "Unexpected error: " + ex.getMessage();
				log.error("API failure", ex);
			}

			if (statusCode != null && statusCode == 200 && responseBody != null) {
				try {
					finalResponse = mapper.readValue(responseBody, CustomerEAuthResponseDTO.class);
				} catch (Exception e) {
					error.setCode("500");
					error.setMessage("Response parsing failed");
					finalResponse.setError(error);
					finalResponse.setStatus("FAILED");
				}
			} else {

				error.setCode(String.valueOf(statusCode));
				error.setMessage(responseBody != null ? responseBody : "API Failed");
				finalResponse.setStatus("FAILED");
				finalResponse.setError(error);
			}

			String errorMsg = (finalResponse.getError() == null || finalResponse.getError().getMessage() == null)
					? "No Error Msg"
					: finalResponse.getError().getMessage();

			// DB Activity --------------------------------------------------------------

			if (masterEntity.isEmpty()) {
				throw new RuntimeException("Customer not found with same Application-No & ExternalRefNo");
			}

			if (masterEntity.isPresent()) {
				master = masterEntity.get();
				masterId = master.getId();
				log.info("VKID :: {}, row :: {}", input.getVkid(), masterId);

				master.setStatus(finalResponse.getStatus());
				master.setActionType("AADHAAR");
				master.setActionSubType("EAUTH-BIOMETRIC");
			}

			// SAVE API LOG
			CustomerApiLogEntity logEntity = new CustomerApiLogEntity();
			logEntity.setMasterId(masterId);
			logEntity.setApiName("CUSTOMER E-AUTH");
			logEntity.setRequestPayload(mapper.writeValueAsString(request));
			logEntity.setResponsePayload(response.getBody());
			logEntity.setStatusCode(response.getStatusCode().value());
			logEntity.setCreatedAt(LocalDateTime.now());
			logEntity.setTraceId(finalResponse.getExternalAppRefNumber());
			logEntity.setErrorMessage(errorMsg);

			// SAVE HISTORY
			CustomerHistoryEntity history = new CustomerHistoryEntity();
			history.setMasterId(masterId);
			history.setExternalAppRefNo(finalResponse.getExternalAppRefNumber());
			history.setApplicationNum(finalResponse.getApplicationNumber());
			history.setApplicationType(applicationType);
			history.setApplicationSubType(applicationSubType);
			history.setApiName("CUSTOMER E-AUTH");
			history.setStatus(finalResponse.getStatus());
			history.setActionType("AADHAAR");
			history.setActionSubType("EAUTH-BIOMETRIC");
			history.setGeneratedDateTime(LocalDateTime.now());
			history.setJioAgentId(agentId);

			// Common Method for Success + Failure [History + API log + Master]
			if ("SUCCESS".equalsIgnoreCase(finalResponse.getStatus())) {
				// Master
				master.setNextActionType("APPLICATION");
				master.setNextActionSubType("SUBMIT");
				master.setStage(7);

				// History
				history.setNextActionType("APPLICATION");
				history.setNextActionSubType("SUBMIT");
				history.setRemarks("Customer E-Auth Done & Verfied");
			} else {
				history.setRemarks("Customer E-Auth Pending");
			}

			masterRepo.save(master);
			apiLogRepo.save(logEntity);
			historyRepo.save(history);
			// --------------------------------------------------------------

			return ResponseEntity.ok(finalResponse);
		} catch (Exception e) {
			log.error("Customer E-Auth Exception", e);
			error.setCode("500");
			error.setMessage(e.getMessage());
			finalResponse.setStatus("FAILED");
			finalResponse.setError(error);
			return ResponseEntity.ok(finalResponse);
		}
	}
	
	// Customer Application Status
	@Override
	public ResponseEntity<?> applicationStatus(CustomerInputRequestDTO input, HttpServletRequest httpRequest) {

		log.info("Application Status Request from Customer :: {}", input.toString());
		ObjectMapper mapper = new ObjectMapper();

		CustomerCommonRequestDTO finalRequest = new CustomerCommonRequestDTO();
		ApplicationStatusResponseDTO finalResponse = new ApplicationStatusResponseDTO();
		ErrorDetails error = new ErrorDetails();
		try {

			// Token
			if (!tokenManager.isAccessTokenValid()) {
				log.info("Token expired → generating new token");
				auth.generateToken(httpRequest);
			}

			finalRequest.setExternalAppRefNumber(input.getExternalAppRefNumber());
			finalRequest.setInitiatingEntityId(channelId);

			log.info("JSON Request for Application Status :: {}", mapper.writeValueAsString(finalRequest));

			HttpHeaders headers = util.buildHeaders(httpRequest, tokenManager.getAccessToken(),
					tokenManager.getAppIdentifierToken(), input.getLatitude(), input.getLongitude());

			HttpEntity<CustomerCommonRequestDTO> entity = new HttpEntity<>(finalRequest, headers);

			ResponseEntity<String> response = null;
			String responseBody = null;
			Integer statusCode = null;

			try {
				response = rest.exchange(applicationStatusURL, HttpMethod.POST, entity, String.class);
				log.info("Application Status Raw Response :: {}", response.getBody());
				responseBody = response.getBody();
				statusCode = response.getStatusCode().value();

			} catch (HttpStatusCodeException ex) {
				statusCode = ex.getStatusCode().value();
				responseBody = ex.getResponseBodyAsString();
				log.error("API error: {}, body: {}", statusCode, responseBody);

			} catch (ResourceAccessException ex) {
				statusCode = 408;
				responseBody = "Timeout: " + ex.getMessage();
				log.error("API timeout", ex);

			} catch (Exception ex) {
				statusCode = 500;
				responseBody = "Unexpected error: " + ex.getMessage();
				log.error("API failure", ex);
			}

			if (statusCode != null && statusCode == 200 && responseBody != null) {
				try {
					finalResponse = mapper.readValue(responseBody, ApplicationStatusResponseDTO.class);
				} catch (Exception e) {
					error.setCode("500");
					error.setMessage("Response parsing failed");
					finalResponse.setError(error);
					finalResponse.setStatus("FAILED");
				}
			} else {

				error.setCode(String.valueOf(statusCode));
				error.setMessage(responseBody != null ? responseBody : "API Failed");
				finalResponse.setStatus("FAILED");
				finalResponse.setError(error);
			}

			return ResponseEntity.ok(finalResponse);

		} catch (Exception e) {
			log.error("Application Status Exception", e);
			throw new RuntimeException("Application Status failed", e);
		}
	}

	// Submit Application
	@Transactional
	@Override
	public ResponseEntity<?> submitApp(CustomerInputRequestDTO input, HttpServletRequest httpRequest) {
		log.info("Submit Application Request from Customer :: {}", input.toString());
		ObjectMapper mapper = new ObjectMapper();
		log.info("JSON Reqest from Customer Submit Application :: {}", mapper.writeValueAsString(input));

		String agentId = null;
		Integer masterId = null;
		CustomerMasterEntity master = null;
		ErrorDetails error = new ErrorDetails();
		SubmitApplicationResponseDTO finalResponse = new SubmitApplicationResponseDTO();
		
		String cardType = input.getAddOn().getCardType();
		String subSubServiceID = (cardType != null && "VIRTUAL".equalsIgnoreCase(cardType)) ? "1485" : "1486";
		Double money = (cardType != null && "VIRTUAL".equalsIgnoreCase(cardType)) ? 100.00 : 400.00;
		
		try {

			Optional<AgentMasterEntity> agentEntity = agentRepo.findByVkidAndJioAgentIdIsNotNull(input.getVkid());
			if (agentEntity.isPresent()) {
				AgentMasterEntity agent = agentEntity.get();
				agentId = agent.getJioAgentId();
				log.info("Agent Master Details for the VKID :: {}, {}", input.getVkid(), agent.toString());
			}

			// Token
			if (!tokenManager.isAccessTokenValid()) {
				log.info("Token expired → generating new token");
				auth.generateToken(httpRequest);
			}

			// Request
			SubmitApplicationRequstDTO request = new SubmitApplicationRequstDTO();
			// Static Value
			request.setApplicationNumber(input.getApplicationNumber());
			request.setExternalAppRefNumber(input.getExternalAppRefNumber());
			request.setApiVersion(apiVersion);
			request.setApplicationType(applicationType);
			request.setApplicationSubType(applicationSubType);
			request.setInitiatingEntityId(channelId);

			// Action
			ActionDTO action = new ActionDTO();
			action.setType("APPLICATION");
			action.setSubType("SUBMIT");
			request.setAction(action);
			
			// Consents
			   Optional.ofNullable(input.getConsents()).ifPresent(con -> {
			    request.setConsents(con);
			   });

			// Organization
			OrganizationDTO org = new OrganizationDTO();
			org.setId(oranizationName);
			request.setOrganization(org);

			// BCDetails
			BCDetailsDTO bc = new BCDetailsDTO();
			bc.setUserId(agentID); // have to change
			//bc.setUserId(agentId);----------------------------------
			request.setBcDetails(bc);

			// Persons + Finance
			PersonDTO person = new PersonDTO();

			//Person Address(Permanent + Communication)
			Optional.ofNullable(input.getPersonAddress()).ifPresent(add -> {
				person.setAddress(add);
			});
			
			Optional.ofNullable(input.getFamilyDetails()).ifPresent(family -> {
				person.setFamilyMembers(family);
			});
			
			// Marital Status
			Optional.ofNullable(input.getMartialStatus()).ifPresent(ms -> {
				PersonalDetailsDTO personDetail = new PersonalDetailsDTO();
				personDetail.setMaritalStatus(ms);
				person.setPersonalDetails(personDetail);
			});

			// Finance
			Optional.ofNullable(input.getFinancialDetails()).ifPresent(fd -> {
				FinancialDetailsDTO finance = new FinancialDetailsDTO();
				finance.setAnnualSalary(fd.getAnnualSalary());
				finance.setSourceOfIncome(fd.getSourceOfIncome());
				finance.setOccupation(fd.getOccupation());
				person.setFinancialDetails(finance);
			});
			request.setPersons(Collections.singletonList(person));

			// Products + Accounts + Contact
			ProductDTO product = new ProductDTO();
			product.setProductType(applicationSubType); // savings

			AccountsDTO accounts = new AccountsDTO();
			NomineeDTO nominee = new NomineeDTO();
			// Nominee Details
			Optional.ofNullable(input.getNomineeDetails()).ifPresent(nom -> {
				nominee.setRelationship(nom.getRelationship());
				nominee.setFirstName(nom.getFirstName());
				nominee.setMiddleName(nom.getMiddleName());
				nominee.setLastName(nom.getLastName());
				nominee.setGender(nom.getGender());
				nominee.setSalutation(nom.getSalutation());
				nominee.setDateOfBirth(nom.getDateOfBirth());
				nominee.setPercentage(nom.getPercentage());
				nominee.setPriority(nom.getPriority());
				nominee.setMinor(nom.isMinor());
			});

			// Nominee Contact Details
			Optional.ofNullable(input.getNomineeContactDetails()).ifPresent(nomCon -> {
				nominee.setContactDetails(nomCon);
			});

			// Nominee Address
			Optional.ofNullable(input.getNomineeAddress()).ifPresent(nomAdd -> {
				nominee.setAddress(Collections.singletonList(nomAdd));
			});

			// Nominee OVD Details
			Optional.ofNullable(input.getNomineeOVDDetails()).ifPresent(nomOVD -> {
				nominee.setOvdDetails(Collections.singletonList(nomOVD));
			});

			// Guardian Details inside nominee
			GuardianDTO guard = new GuardianDTO();
			Optional.ofNullable(input.getGuardianDetails()).ifPresent(grdDet -> {
				guard.setFirstName(grdDet.getFirstName());
				guard.setMiddleName(grdDet.getMiddleName());
				guard.setLastName(grdDet.getLastName());
				guard.setDateOfBirth(grdDet.getDateOfBirth());
				guard.setRelationship(grdDet.getRelationship());
			});

			// Guardian Contact Details
			Optional.ofNullable(input.getGuardianContactDetails()).ifPresent(grdCon -> {
				guard.setContactDetails(grdCon);
			});

			// Guardian OVD Details
			Optional.ofNullable(input.getGuardianOVDDetails()).ifPresent(grdOVD -> {
				guard.setOvdDetails(Collections.singletonList(grdOVD));
			});

			// Guardian Address
			Optional.ofNullable(input.getGuardianAddress()).ifPresent(grdAdd -> {
				guard.setAddress(Collections.singletonList(grdAdd));
			});

			// Add-On
			Optional.ofNullable(input.getAddOn()).ifPresent(addOn -> {
				AddOnDTO addONDTO = new AddOnDTO();
				addONDTO.setDebitCardDetails(Collections.singletonList(addOn));
				product.setAddOn(Collections.singletonList(addONDTO));
			});

			// Set guardian only if data is available
			if (guard.getFirstName() != null
			        || guard.getMiddleName() != null
			        || guard.getLastName() != null
			        || guard.getDateOfBirth() != null
			        || guard.getRelationship() != null
			        || guard.getContactDetails() != null
			        || guard.getOvdDetails() != null
			        || guard.getAddress() != null) {

			    nominee.setGuardian(Collections.singletonList(guard));
			}else {
			    nominee.setGuardian(Collections.emptyList());
			}
			
			if (nominee.getRelationship() != null
			        || nominee.getFirstName() != null
			        || guard.getLastName() != null
			        ) {

				accounts.setNominee(Collections.singletonList(nominee));
			}
			
			
			product.setAccounts(Collections.singletonList(accounts));
			request.setProducts(Collections.singletonList(product));

			log.info("Submit Application request :: {}", request.toString());
			log.info("JSON Request for Submit Application :: {}", mapper.writeValueAsString(request));

			HttpHeaders headers = util.buildHeaders(httpRequest, tokenManager.getAccessToken(),
					tokenManager.getAppIdentifierToken(), input.getLatitude(), input.getLongitude());

			HttpEntity<SubmitApplicationRequstDTO> entity = new HttpEntity<>(request, headers);

			ResponseEntity<String> response = null;
			String responseBody = null;
			Integer statusCode = null;
			try {
				
//				responseBody = "{\"externalAppRefNumber\":\"REF1778134161432\","
//				        + "\"applicationNumber\":\"JPBREF177813416143248964\","
//				        + "\"status\":\"SUCCESS\","
//				        + "\"data\":[\"/app/jpbCustomerOnboardingModule_8990/File/REF1778134161432/CON_REF1778134161432_CAF_CUST_1778134628422.pdf\"]}";
//				statusCode = 200;
				
				response = rest.exchange(URL, HttpMethod.POST, entity, String.class);
				log.info("Submit Application Raw Response :: {}", response.getBody());
				responseBody = response.getBody();
				statusCode = response.getStatusCode().value();
					
			} catch (HttpStatusCodeException ex) {
				statusCode = ex.getStatusCode().value();
				responseBody = ex.getResponseBodyAsString();
				log.error("API error: {}, body: {}", statusCode, responseBody);

			} catch (ResourceAccessException ex) {
				statusCode = 408;
				responseBody = "Timeout: " + ex.getMessage();
				log.error("API timeout", ex);

			} catch (Exception ex) {
				statusCode = 500;
				responseBody = "Unexpected error: " + ex.getMessage();
				log.error("API failure", ex);
			}

			if (statusCode != null && statusCode == 200 && responseBody != null) {
				try {
					finalResponse = mapper.readValue(responseBody, SubmitApplicationResponseDTO.class);
				} catch (Exception e) {
					error.setCode("500");
					error.setMessage("Response parsing failed");
					finalResponse.setError(error);
					finalResponse.setStatus("FAILED");
				}
			} else {

				error.setCode(String.valueOf(statusCode));
				error.setMessage(responseBody != null ? responseBody : "API Failed");
				finalResponse.setStatus("FAILED");
				finalResponse.setError(error);
			}

			String errorMsg = (finalResponse.getError() == null || finalResponse.getError().getMessage() == null)
					? "No Error Msg" : finalResponse.getError().getMessage();

			// DB Activity --------------------------------------------------------------
			log.info("SubSubServiceID for Money Debit :: {}, Total Sum to be deduceted from Wallet :: {}", subSubServiceID, money);
			
			// Money debit----------
			DebitTransactionEntity debit = debitRepo.debitTransaction
					(input.getExternalAppRefNumber(), //unique transaction ID
					"Payment For JPB", //Remarks
					"1", //service ID
					"1335", //Sub Service ID
					subSubServiceID, //Sub Sub Service ID 1485-100, 1486-400 
					"0", //Sub Sub Sub Service ID
					input.getVkid(),
					"1", //Wallet ID
					money, //Amount
					input.getVkid(), //BCID
					input.getExternalAppRefNumber(), //RRN No
					"1", //Transaction Authentication Type
					"1" //Transaction Type
					);
		
			log.info("Debit Transaction Details :: {}", debit.toString());
			if("Y".equalsIgnoreCase(debit.getUpdateStatus())) {
				log.info("Payment Successful---->");
			} else {
				log.info("Payment Pending---->");
			}
			
			Optional<CustomerMasterEntity> masterEntity = masterRepo.findByApplicationNumberAndExternalAppRefNumber(
					input.getApplicationNumber(), input.getExternalAppRefNumber());

			if (masterEntity.isEmpty()) {
				throw new RuntimeException("Customer not found with same Application-No & ExternalRefNo");
			}

			if (masterEntity.isPresent()) {
				master = masterEntity.get();
				masterId = master.getId();
				log.info("VKID :: {}, row :: {}", input.getVkid(), masterId);

				master.setActionType("APPLICATION");
				master.setActionSubType("SUBMIT");
				master.setEmail(input.getEmailId());
				master.setStatus(finalResponse.getStatus());
				
				//Transaction
				master.setCardOpted(cardType);
				master.setTransactionId(input.getExternalAppRefNumber());
				master.setTransactionStatus(debit.getUpdateStatus());
				master.setTransactionTime(LocalDateTime.now());
			}

			// SAVE API LOG
			CustomerApiLogEntity logEntity = new CustomerApiLogEntity();
			logEntity.setMasterId(masterId);
			logEntity.setApiName("SUBMIT_APP");
			logEntity.setRequestPayload(mapper.writeValueAsString(request));
			logEntity.setResponsePayload(response.getBody());
			logEntity.setStatusCode(response.getStatusCode().value());
			logEntity.setCreatedAt(LocalDateTime.now());
			logEntity.setTraceId(finalResponse.getExternalAppRefNumber());
			logEntity.setErrorMessage(errorMsg);

			// SAVE HISTORY
			CustomerHistoryEntity history = new CustomerHistoryEntity();
			history.setMasterId(masterId);
			history.setExternalAppRefNo(input.getExternalAppRefNumber());
			history.setApplicationNum(finalResponse.getApplicationNumber());
			history.setApplicationType(applicationType);
			history.setApplicationSubType(applicationSubType);
			history.setApiName("SUMBIT_APP");
			history.setStatus(finalResponse.getStatus());
			history.setActionType("APPLICATION");
			history.setActionSubType("SUBMIT");
			history.setGeneratedDateTime(LocalDateTime.now());
			history.setJioAgentId(agentId);

			// Common Method for Success + Failure [History + API log + Master]
			if ("SUCCESS".equalsIgnoreCase(finalResponse.getStatus())) {
				// Master
				master.setNextActionType("SUBMITTED");
				master.setNextActionSubType("EXIT");
				master.setStage(7);

				// History
				history.setNextActionType("SUBMITTED");
				history.setNextActionSubType("EXIT");
				history.setRemarks("Application Submitted");
			} else {
				history.setRemarks("Application Submit Pending");
			}

			masterRepo.save(master);
			apiLogRepo.save(logEntity);
			historyRepo.save(history);
			// --------------------------------------------------------------
			return ResponseEntity.ok(finalResponse);

		} catch (Exception e) {
			log.error("Submit Application Exception", e);
			error.setCode("500");
			error.setMessage(e.getMessage());
			finalResponse.setStatus("FAILED");
			finalResponse.setError(error);
			return ResponseEntity.ok(finalResponse);
		}
	}
}
