	//Final Submit Application
	// Submit Application
	@Transactional
	@Override
	public ResponseEntity<?> submitApp(CustomerInputRequestDTO input, HttpServletRequest httpRequest) {
		log.info("Submit Application Request from Customer :: {}", input.toString());
		ObjectMapper mapper = new ObjectMapper();
		log.info("JSON Reqest from Customer Submit Application :: {}", mapper.writeValueAsString(input));

		String agentId = null;
		Integer masterId = null;
		CustomerMasterEntity master = null;
		ErrorDetails error = new ErrorDetails();
		SubmitApplicationResponseDTO finalResponse = new SubmitApplicationResponseDTO();
		
		String cardType = input.getAddOn().getCardType();
		String subSubServiceID = (cardType != null && "VIRTUAL".equalsIgnoreCase(cardType)) ? "1485" : "1486";
		Double money = (cardType != null && "VIRTUAL".equalsIgnoreCase(cardType)) ? 100.00 : 400.00;
		
		try {

			Optional<AgentMasterEntity> agentEntity = agentRepo.findByVkidAndJioAgentIdIsNotNull(input.getVkid());
			if (agentEntity.isPresent()) {
				AgentMasterEntity agent = agentEntity.get();
				agentId = agent.getJioAgentId();
				log.info("Agent Master Details for the VKID :: {}, {}", input.getVkid(), agent.toString());
			}

			// Token
			if (!tokenManager.isAccessTokenValid()) {
				log.info("Token expired → generating new token");
				auth.generateToken(httpRequest);
			}

			// Request
			SubmitApplicationRequstDTO request = new SubmitApplicationRequstDTO();
			// Static Value
			request.setApplicationNumber(input.getApplicationNumber());
			request.setExternalAppRefNumber(input.getExternalAppRefNumber());
			request.setApiVersion(apiVersion);
			request.setApplicationType(applicationType);
			request.setApplicationSubType(applicationSubType);
			request.setInitiatingEntityId(channelId);

			// Action
			ActionDTO action = new ActionDTO();
			action.setType("APPLICATION");
			action.setSubType("SUBMIT");
			request.setAction(action);
			
			// Consents
			   Optional.ofNullable(input.getConsents()).ifPresent(con -> {
			    request.setConsents(con);
			   });

			// Organization
			OrganizationDTO org = new OrganizationDTO();
			org.setId(oranizationName);
			request.setOrganization(org);

			// BCDetails
			BCDetailsDTO bc = new BCDetailsDTO();
			//bc.setUserId(agentID); // have to change
			bc.setUserId(agentId);
			request.setBcDetails(bc);

			// Persons + Finance
			PersonDTO person = new PersonDTO();

			//Person Address(Permanent + Communication)
			Optional.ofNullable(input.getPersonAddress()).ifPresent(add -> {
				person.setAddress(add);
			});
			
			Optional.ofNullable(input.getFamilyDetails()).ifPresent(family -> {
				person.setFamilyMembers(family);
			});
			
			// Marital Status
			Optional.ofNullable(input.getMartialStatus()).ifPresent(ms -> {
				PersonalDetailsDTO personDetail = new PersonalDetailsDTO();
				personDetail.setMaritalStatus(ms);
				person.setPersonalDetails(personDetail);
			});

			// Finance
			Optional.ofNullable(input.getFinancialDetails()).ifPresent(fd -> {
				FinancialDetailsDTO finance = new FinancialDetailsDTO();
				finance.setAnnualSalary(fd.getAnnualSalary());
				finance.setSourceOfIncome(fd.getSourceOfIncome());
				finance.setOccupation(fd.getOccupation());
				person.setFinancialDetails(finance);
			});
			request.setPersons(Collections.singletonList(person));

			// Products + Accounts + Contact
			ProductDTO product = new ProductDTO();
			product.setProductType(applicationSubType); // savings

			AccountsDTO accounts = new AccountsDTO();
			NomineeDTO nominee = new NomineeDTO();
			// Nominee Details
			Optional.ofNullable(input.getNomineeDetails()).ifPresent(nom -> {
				nominee.setRelationship(nom.getRelationship());
				nominee.setFirstName(nom.getFirstName());
				nominee.setMiddleName(nom.getMiddleName());
				nominee.setLastName(nom.getLastName());
				nominee.setGender(nom.getGender());
				nominee.setSalutation(nom.getSalutation());
				nominee.setDateOfBirth(nom.getDateOfBirth());
				nominee.setPercentage(nom.getPercentage());
				nominee.setPriority(nom.getPriority());
				nominee.setMinor(nom.isMinor());
			});

			// Nominee Contact Details
			Optional.ofNullable(input.getNomineeContactDetails()).ifPresent(nomCon -> {
				nominee.setContactDetails(nomCon);
			});

			// Nominee Address
			Optional.ofNullable(input.getNomineeAddress()).ifPresent(nomAdd -> {
				nominee.setAddress(Collections.singletonList(nomAdd));
			});

			// Nominee OVD Details
			Optional.ofNullable(input.getNomineeOVDDetails()).ifPresent(nomOVD -> {
				nominee.setOvdDetails(Collections.singletonList(nomOVD));
			});

			// Guardian Details inside nominee
			GuardianDTO guard = new GuardianDTO();
			Optional.ofNullable(input.getGuardianDetails()).ifPresent(grdDet -> {
				guard.setFirstName(grdDet.getFirstName());
				guard.setMiddleName(grdDet.getMiddleName());
				guard.setLastName(grdDet.getLastName());
				guard.setDateOfBirth(grdDet.getDateOfBirth());
				guard.setRelationship(grdDet.getRelationship());
			});

			// Guardian Contact Details
			Optional.ofNullable(input.getGuardianContactDetails()).ifPresent(grdCon -> {
				guard.setContactDetails(grdCon);
			});

			// Guardian OVD Details
			Optional.ofNullable(input.getGuardianOVDDetails()).ifPresent(grdOVD -> {
				guard.setOvdDetails(Collections.singletonList(grdOVD));
			});

			// Guardian Address
			Optional.ofNullable(input.getGuardianAddress()).ifPresent(grdAdd -> {
				guard.setAddress(Collections.singletonList(grdAdd));
			});

			// Add-On
			Optional.ofNullable(input.getAddOn()).ifPresent(addOn -> {
				AddOnDTO addONDTO = new AddOnDTO();
				addONDTO.setDebitCardDetails(Collections.singletonList(addOn));
				product.setAddOn(Collections.singletonList(addONDTO));
			});

			// Set guardian only if data is available
			if (guard.getFirstName() != null
			        || guard.getMiddleName() != null
			        || guard.getLastName() != null
			        || guard.getDateOfBirth() != null
			        || guard.getRelationship() != null
			        || guard.getContactDetails() != null
			        || guard.getOvdDetails() != null
			        || guard.getAddress() != null) {

			    nominee.setGuardian(Collections.singletonList(guard));
			}else {
			    nominee.setGuardian(Collections.emptyList());
			}
			
			if (nominee.getRelationship() != null
			        || nominee.getFirstName() != null
			        || guard.getLastName() != null
			        ) {

				accounts.setNominee(Collections.singletonList(nominee));
			}
			
			
			product.setAccounts(Collections.singletonList(accounts));
			request.setProducts(Collections.singletonList(product));

			log.info("Submit Application request :: {}", request.toString());
			log.info("JSON Request for Submit Application :: {}", mapper.writeValueAsString(request));

			HttpHeaders headers = util.buildHeaders(httpRequest, tokenManager.getAccessToken(),
					tokenManager.getAppIdentifierToken(), input.getLatitude(), input.getLongitude());

			HttpEntity<SubmitApplicationRequstDTO> entity = new HttpEntity<>(request, headers);

			ResponseEntity<String> response = null;
			String responseBody = null;
			Integer statusCode = null;
			try {
				
//				responseBody = "{\"externalAppRefNumber\":\"REF1778134161432\","
//				        + "\"applicationNumber\":\"JPBREF177813416143248964\","
//				        + "\"status\":\"SUCCESS\","
//				        + "\"data\":[\"/app/jpbCustomerOnboardingModule_8990/File/REF1778134161432/CON_REF1778134161432_CAF_CUST_1778134628422.pdf\"]}";
//				statusCode = 200;
				
				response = rest.exchange(URL, HttpMethod.POST, entity, String.class);
				log.info("Submit Application Raw Response :: {}", response.getBody());
				responseBody = response.getBody();
				statusCode = response.getStatusCode().value();
					
			} catch (HttpStatusCodeException ex) {
				statusCode = ex.getStatusCode().value();
				responseBody = ex.getResponseBodyAsString();
				log.error("API error: {}, body: {}", statusCode, responseBody);

			} catch (ResourceAccessException ex) {
				statusCode = 408;
				responseBody = "Timeout: " + ex.getMessage();
				log.error("API timeout", ex);

			} catch (Exception ex) {
				statusCode = 500;
				responseBody = "Unexpected error: " + ex.getMessage();
				log.error("API failure", ex);
			}

			if (statusCode != null && statusCode == 200 && responseBody != null) {
				try {
					finalResponse = mapper.readValue(responseBody, SubmitApplicationResponseDTO.class);
				} catch (Exception e) {
					error.setCode("500");
					error.setMessage("Response parsing failed");
					finalResponse.setError(error);
					finalResponse.setStatus("FAILED");
				}
			} else {

				error.setCode(String.valueOf(statusCode));
				error.setMessage(responseBody != null ? responseBody : "API Failed");
				finalResponse.setStatus("FAILED");
				finalResponse.setError(error);
			}

			String errorMsg = (finalResponse.getError() == null || finalResponse.getError().getMessage() == null)
					? "No Error Msg" : finalResponse.getError().getMessage();

			// DB Activity --------------------------------------------------------------
			log.info("SubSubServiceID for Money Debit :: {}, Total Sum to be deduceted from Wallet :: {}", subSubServiceID, money);
			
			// Money debit----------
			DebitTransactionEntity debit = debitRepo.debitTransaction
					(input.getExternalAppRefNumber(), //unique transaction ID
					"Payment For JPB", //Remarks
					"1", //service ID
					"1335", //Sub Service ID
					subSubServiceID, //Sub Sub Service ID 1485-100, 1486-400 
					"0", //Sub Sub Sub Service ID
					input.getVkid(),
					"1", //Wallet ID
					money, //Amount
					input.getVkid(), //BCID
					input.getExternalAppRefNumber(), //RRN No
					"1", //Transaction Authentication Type
					"1" //Transaction Type
					);
		
			log.info("Debit Transaction Details :: {}", debit.toString());
			if("Y".equalsIgnoreCase(debit.getUpdateStatus())) {
				log.info("Payment Successful---->");
			} else {
				log.info("Payment Pending---->");
			}
			
			Optional<CustomerMasterEntity> masterEntity = masterRepo.findByApplicationNumberAndExternalAppRefNumber(
					input.getApplicationNumber(), input.getExternalAppRefNumber());

			if (masterEntity.isEmpty()) {
				throw new RuntimeException("Customer not found with same Application-No & ExternalRefNo");
			}

			if (masterEntity.isPresent()) {
				master = masterEntity.get();
				masterId = master.getId();
				log.info("VKID :: {}, row :: {}", input.getVkid(), masterId);

				master.setActionType("APPLICATION");
				master.setActionSubType("SUBMIT");
				master.setEmail(input.getEmailId());
				master.setStatus(finalResponse.getStatus());
				
				//Transaction
				master.setCardOpted(cardType);
				master.setTransactionId(input.getExternalAppRefNumber());
				master.setTransactionStatus(debit.getUpdateStatus());
				master.setTransactionTime(LocalDateTime.now());
			}

			// SAVE API LOG
			CustomerApiLogEntity logEntity = new CustomerApiLogEntity();
			logEntity.setMasterId(masterId);
			logEntity.setApiName("SUBMIT_APP");
			logEntity.setRequestPayload(mapper.writeValueAsString(request));
			logEntity.setResponsePayload(response.getBody());
			logEntity.setStatusCode(response.getStatusCode().value());
			logEntity.setCreatedAt(LocalDateTime.now());
			logEntity.setTraceId(finalResponse.getExternalAppRefNumber());
			logEntity.setErrorMessage(errorMsg);

			// SAVE HISTORY
			CustomerHistoryEntity history = new CustomerHistoryEntity();
			history.setMasterId(masterId);
			history.setExternalAppRefNo(input.getExternalAppRefNumber());
			history.setApplicationNum(finalResponse.getApplicationNumber());
			history.setApplicationType(applicationType);
			history.setApplicationSubType(applicationSubType);
			history.setApiName("SUMBIT_APP");
			history.setStatus(finalResponse.getStatus());
			history.setActionType("APPLICATION");
			history.setActionSubType("SUBMIT");
			history.setGeneratedDateTime(LocalDateTime.now());
			history.setJioAgentId(agentId);

			// Common Method for Success + Failure [History + API log + Master]
			if ("SUCCESS".equalsIgnoreCase(finalResponse.getStatus())) {
				// Master
				master.setNextActionType("SUBMITTED");
				master.setNextActionSubType("EXIT");
				master.setStage(8);

				// History
				history.setNextActionType("SUBMITTED");
				history.setNextActionSubType("EXIT");
				history.setRemarks("Application Submitted");
			} else {
				history.setRemarks("Application Submit Pending");
			}

			masterRepo.save(master);
			apiLogRepo.save(logEntity);
			historyRepo.save(history);
			// --------------------------------------------------------------
			return ResponseEntity.ok(finalResponse);

		} catch (Exception e) {
			log.error("Submit Application Exception", e);
			error.setCode("500");
			error.setMessage(e.getMessage());
			finalResponse.setStatus("FAILED");
			finalResponse.setError(error);
			return ResponseEntity.ok(finalResponse);
		}
	}
}
