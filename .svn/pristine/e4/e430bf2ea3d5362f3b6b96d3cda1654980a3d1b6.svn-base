package com.jpb.Service;

import org.springframework.http.ResponseEntity;

import com.jpb.DTO.CustomerInputRequestDTO;

import jakarta.servlet.http.HttpServletRequest;

public interface RefundService {

	ResponseEntity<?> voucherVerify(CustomerInputRequestDTO request, HttpServletRequest httpRequest);

	ResponseEntity<?> voucherRedeem(CustomerInputRequestDTO request, HttpServletRequest httpRequest);

	ResponseEntity<?> voucherResend(CustomerInputRequestDTO request, HttpServletRequest httpRequest);

	ResponseEntity<?> customerVoucherFailed(CustomerInputRequestDTO request, HttpServletRequest httpRequest);

}
