package com.jpb.Controller;

import org.springframework.web.bind.annotation.CrossOrigin;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import java.io.File;
import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.dao.EmptyResultDataAccessException;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;
import org.springframework.web.multipart.MultipartFile;

import lombok.extern.slf4j.Slf4j;

@RestController
@RequestMapping("/jpb")
@CrossOrigin("*")
@Slf4j
public class JPBPreCheckController {

	@Value("${precheck.jpb.url}")
	private String IMAGE_UPLOAD_DIRECTORY;

	@Value("${jio.onbording.url}")
	private String image_URL;

	@Autowired
	private JdbcTemplate jdbcTemplate;

	@PostMapping("/uploadOnboardingimages")
	public ResponseEntity<?> submitAtmSiteApprovalStatus(@RequestParam("vkid") String vkid,
			@RequestParam("latitude") String latitude, @RequestParam("longitude") String longitude,
			@RequestParam("image1") MultipartFile image1, @RequestParam("image2") MultipartFile image2,
			@RequestParam("image3") MultipartFile image3, @RequestParam("image4") MultipartFile image4,
			@RequestParam("image5") MultipartFile image5, @RequestParam("image6") MultipartFile image6,
			@RequestParam("image7") MultipartFile image7, @RequestParam("image8") MultipartFile image8) {
		// Common Response
		Map<String, Object> response = new HashMap<>();

		if (vkid == null || !vkid.matches("^[a-zA-Z0-9]{9}$")) {
			response.put("status", false);
			response.put("message", "Invalid vkid. vkid must be 9 alphanumeric characters.");
			return new ResponseEntity<>(response, HttpStatus.OK);
		}
		String checkExistenceQuery1 = "SELECT COUNT(*) FROM BankingJio.uploadimages WHERE VKID = ?";
		int counts = jdbcTemplate.queryForObject(checkExistenceQuery1, Integer.class, vkid);
		if (counts == 0) {

			MultipartFile[] images = { image1, image2, image3, image4, image5, image6, image7, image8 };

			for (int i = 0; i < images.length; i++) {
				if (images[i] == null || images[i].isEmpty()) {
					response.put("status", false);
					response.put("message", "Image " + (i + 1) + " is missing");
					return new ResponseEntity<>(response, HttpStatus.OK);
				}
			}

			// Create folder for the specific Vkid if it doesn't exist
			Path applicationFolderPath = Paths.get(IMAGE_UPLOAD_DIRECTORY + File.separator + vkid);
			File applicationFolder = applicationFolderPath.toFile();
			if (!applicationFolder.exists()) {
				applicationFolder.mkdirs();
			}

			String checkExistenceQuery = "SELECT COUNT(*) FROM BankingJio.uploadimages WHERE VKID = ?";
			int count = jdbcTemplate.queryForObject(checkExistenceQuery, Integer.class, vkid);
			try {

				if (count > 0) {
					response.put("status", false);
					response.put("message", "The application has already been submitted for this vkid.");
					return new ResponseEntity<>(response, HttpStatus.OK);
				}
			} catch (EmptyResultDataAccessException e) {
				return null;
			}

			if (longitude == null || longitude.trim().isEmpty() || latitude == null || latitude.trim().isEmpty()) {
				response.put("status", false);
				response.put("message", "Latitude and Longitude should not be empty or null.");
				return new ResponseEntity<>(response, HttpStatus.OK);
			}

			try {
				for (int i = 1; i <= images.length; i++) {
					Path oldImagePath = applicationFolderPath.resolve(vkid + i + ".jpg");
					if (Files.exists(oldImagePath)) {
						Files.delete(oldImagePath);
						log.info("Deleted old image: " + oldImagePath);
					} else {
						log.info("Old image " + vkid + i + ".jpg not found.");
					}
				}
			} catch (IOException e) {
				e.printStackTrace();
				return new ResponseEntity<>("Error deleting old images: " + e.getMessage(), HttpStatus.OK);
			}

			for (int i = 0; i < images.length; i++) {
				MultipartFile image = images[i];
				if (image.isEmpty()) {
					return new ResponseEntity<>("Image " + (i + 1) + " is missing", HttpStatus.OK);
				}

				try {
					// Generate image file name as vkid1.jpg, vkid2.jpg, etc.
					String imageFileName = vkid + (i + 1) + ".jpg";
					Path imagePath = applicationFolderPath.resolve(imageFileName);

					// Write the image to the file system
					Files.write(imagePath, image.getBytes());
					log.info("Saved new image: " + imageFileName);

				} catch (IOException e) {
					e.printStackTrace();
					response.put("message", "error saving images");
					response.put("status", false);
					return new ResponseEntity<>(response, HttpStatus.OK);
				}
			}

			String insetimages = "insert into BankingJio.uploadimages"
					+ "(vkid,latitude,longitude,image1,image2,image3,image4,image5,image6,image7,image8)"
					+ "VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?,?,?)";

			int rows = jdbcTemplate.update(insetimages, vkid, latitude, longitude, 1, 1, 1, 1, 1, 1, 1, 1);

			log.info("savedimages" + rows);
			response.put("message", "The Application is submited successfully");
			response.put("status", true);
			return new ResponseEntity<>(response, HttpStatus.OK);
		} else {

			return null;

		}

	}

	@PostMapping("/veiwApplication")
	public ResponseEntity<?> veiwApplication(@RequestBody Map<String, Object> request) {
		String vkid = (String) request.get("vkid");

		// Step 1: Validate vkid
		if (vkid == null || !vkid.matches("^[a-zA-Z0-9]{9}$")) {
			Map<String, Object> response = new HashMap<>();
			response.put("status", false);
			response.put("message", "Invalid vk_id");
			return new ResponseEntity<>(response, HttpStatus.OK);
		}

		String selectSql = "SELECT * FROM BankingJio.uploadimages WHERE VKID = ?";
		System.out.println("Executing query: " + selectSql); // Debugging line to see the query

		List<Map<String, Object>> result = jdbcTemplate.queryForList(selectSql, vkid);
		System.out.println("Database Query Result: " + result);
		// Prepare the response data
		Map<String, Object> responseData = new LinkedHashMap<>();
		List<Map<String, Object>> recordsWithImages = new ArrayList<>();
		String applicationFolderPath = IMAGE_UPLOAD_DIRECTORY + "/" + vkid;
		File applicationFolder = new File(applicationFolderPath);

		if (applicationFolder.exists() && applicationFolder.isDirectory()) {
			File[] imageFiles = applicationFolder
					.listFiles((dir, name) -> name.matches(".*\\.(jpg|jpeg|png|gif|bmp|tiff|webp)$"));

			// Define the expected image names based on the index
			// Define descriptions for images

			// Ensure the loop dynamically builds image URLs with unique names
			for (int i = 0; i < result.size(); i++) {
				Map<String, Object> record = result.get(i);

				// Set unique image URLs and descriptions
				// int imageId = (int) record.get("image_id");
				// String Vkid = (String) record.get("vk_id");

				// Dynamically generate the image file name using imageId
				List<String> imageUrls = new ArrayList<>();

				for (int j = 1; j <= 6; j++) {

					String imageName = vkid + j + ".jpg";

					File imageFile = new File(applicationFolderPath + "/" + imageName);

					if (imageFile.exists()) {

						String imageUrl = image_URL + vkid + "/" + imageName;

						imageUrls.add(imageUrl);
					}
				}

				record.put("images", imageUrls);
				// Add updated record to the result list (or process further as needed)
				recordsWithImages.add(record);
			}
		}

		// Prepare the final response data
		// Map<String, Object> response = new LinkedHashMap<>();
		if (recordsWithImages != null && !recordsWithImages.isEmpty()) {

			responseData.put("records", recordsWithImages);
			// Map<String, Object> response = new LinkedHashMap<>();
			responseData.put("status", true);
			responseData.put("Screenstatus", true);
			responseData.put("message", "Data viewed successfully");
			// response.( responseData);
			return new ResponseEntity<>(responseData, HttpStatus.OK);
		}
		responseData.put("records", recordsWithImages);
		// Map<String, Object> response = new LinkedHashMap<>();
		responseData.put("Screenstatus", false);
		responseData.put("status", true);
		responseData.put("message", "Data viewed successfully");
		// response.( responseData);
		return new ResponseEntity<>(responseData, HttpStatus.OK);
	}

}
