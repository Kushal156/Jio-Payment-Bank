package com.jpb.Entity;

import jakarta.persistence.*;
import lombok.Data;

//import jakarta.persistence.Entity;

@Entity
@Data
@Table(name = "vkms_properties_master", schema = "[vkms]")
public class VkmsPropertiesMasterEntity {
	
	@Id
	@Column(name ="vkms_property_id")
	private int id;
	
	@Column(name ="vkms_property_key")
	private String  vkmspropertykey;
	
	@Column(name ="vkms_property_value")
	private String vkmspropertyvalue;

}
