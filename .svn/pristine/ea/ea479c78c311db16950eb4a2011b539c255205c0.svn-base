package com.jpb.Entity;

import jakarta.persistence.*;
import lombok.Data;

@Entity
@Data
@Table(name = "vkl_master", schema = "[dbo]")
public class JioOnboardingVklMasterEntity {
	
	     @Id
	    @Column(name = "v_id")
	    private int id;
	
	@Column(name = "application_no")
	private String applicationNo;
	
	@Column(name = "vk_id")
	private String VKID;

}
